    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/commander": "^11.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  },
