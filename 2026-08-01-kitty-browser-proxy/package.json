{
  "name": "kitty-browser-proxy",
  "version": "1.0.0",
  "description": "Stream off‑screen Chromium frames over WebSocket to Kitty‑compatible terminals for full‑fidelity web browsing inside headless environments.",
  "homepage": "https://github.com/asmit25805/kitty-browser-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmit25805/kitty-browser-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/asmit25805/kitty-browser-proxy/issues"
  },
  "keywords": [
    "kitty",
    "terminal",
    "electron",
    "websocket",
    "headless",
    "browser",
    "proxy"
  ],
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "kitty-browser-proxy": "./dist/cli/cli.js"
  },
  "scripts": {
